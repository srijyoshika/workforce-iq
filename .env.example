# =============================================================================
# WorkforceIQ Root Environment Configuration Template
# =============================================================================

# Application Metadata
APP_NAME=WorkforceIQ
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# Security (Change SECRET_KEY in production!)
SECRET_KEY=change-this-to-a-secure-random-64-character-string-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80"]

# PostgreSQL Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=workforce_user
POSTGRES_PASSWORD=workforce_secure_password_2026
POSTGRES_DB=workforce_iq

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_FALLBACK_SQLITE=false

# Frontend Environment Variables
VITE_API_BASE_URL=/api/v1

