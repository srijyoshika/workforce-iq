# WorkforceIQ Frontend Environment Configuration

# API Base URL (Proxy route or full origin)
VITE_API_BASE_URL=/api/v1

# Application Metadata
VITE_APP_NAME=WorkforceIQ
VITE_APP_VERSION=1.0.0
VITE_ENV=development

# Polling interval for live system health checks (milliseconds)
VITE_HEALTH_POLL_INTERVAL=15000

