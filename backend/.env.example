# WorkforceIQ Backend Environment Configuration

# Application
APP_NAME=WorkforceIQ
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
HOST=127.0.0.1
PORT=8000

# Security
SECRET_KEY=workforceiq-super-secret-development-key-change-in-production-2026
ALLOWED_HOSTS=["*"]

# CORS Configuration (JSON array or comma-separated list of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database Configuration (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=workforce_iq

# Direct Database URL Override (Optional)
# If provided, takes precedence over POSTGRES_* settings
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/workforce_iq

# In development mode, fallback to SQLite if PostgreSQL server is offline
# Set to False to enforce strict PostgreSQL connection
DB_FALLBACK_SQLITE=True
SQLITE_DB_PATH=./workforce_iq_dev.db

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

